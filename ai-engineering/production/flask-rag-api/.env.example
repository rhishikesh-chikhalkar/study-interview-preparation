# Production Flask RAG API Environment Configuration

# OpenAI API Key (Required for production generation and embeddings)
OPENAI_API_KEY=sk-proj-your-api-key-here

# Vector Store Settings
CHROMA_DB_DIR=./_tmp/chroma_db
CHROMA_COLLECTION=pdf_rag_collection_openai

# Local Ollama Fallback Settings (Optional)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
LLM_MODEL=qwen3:1.7b

# Service Server Settings
PORT=5001
FLASK_DEBUG=false
